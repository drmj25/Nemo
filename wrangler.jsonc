{
  "name": "nemo-ai",
  "main": "worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-10-01",
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "NEMO_DB",
      "database_name": "nemo-agent",
      "database_id": "c9aca664-abd5-403d-9cfe-8ddd62e6000c"
    }
  ]
}
